FROM node:20-alpine
RUN apk add --no-cache openssl
WORKDIR /app
COPY package*.json ./
COPY apps/api/package.json apps/api/
COPY packages/database/package.json packages/database/
RUN npm install
COPY . .
RUN npm run db:generate && npm run build
ENV NODE_ENV=production
EXPOSE 3001
CMD ["sh", "-c", "npx prisma db push --schema packages/database/prisma/schema.prisma --skip-generate && npm run db:seed && node apps/api/dist/main.js"]
