generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATOR
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  status        TenantStatus   @default(ACTIVE)
  timezone      String         @default("America/Argentina/Buenos_Aires")
  contactPhone  String?
  address       String?
  city          String?
  province      String?
  country       String         @default("Argentina")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  services      Service[]
  contacts      Contact[]
  businessHours BusinessHour[]
  blockedSlots  BlockedSlot[]
  appointments  Appointment[]
  agents        Agent[]
  whatsappNumbers WhatsAppNumber[]
  conversations Conversation[]
  messages      Message[]
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
  assignedConversations Conversation[]

  @@index([tenantId])
}

model Plan {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  priceCents    Int            @default(0)
  currency      String         @default("ARS")
  limits        Json
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(uuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId])
  @@index([status, currentPeriodEnd])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  MANUAL
  AGENT
}

model Service {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  durationMin  Int
  priceCents   Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([tenantId])
}

model Contact {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model BusinessHour {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startMin  Int
  endMin    Int

  @@index([tenantId, dayOfWeek])
}

model BlockedSlot {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([tenantId, startsAt])
}

model Appointment {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    AppointmentStatus @default(CONFIRMED)
  source    AppointmentSource @default(MANUAL)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tenantId, startsAt])
  @@index([contactId])
}

model Agent {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  personality  String?
  instructions String?
  language     String   @default("es")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

enum NumberMode {
  OWN
  PLATFORM
}

enum NumberStatus {
  PENDING
  CONNECTED
  DISCONNECTED
}

model WhatsAppNumber {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String       @unique
  label     String?
  mode      NumberMode   @default(PLATFORM)
  status    NumberStatus @default(PENDING)
  phoneNumberId  String?  @unique
  wabaId         String?
  accessTokenEnc String?
  connectedAt    DateTime?
  conversations  Conversation[]
  createdAt DateTime     @default(now())

  @@index([tenantId])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageSender {
  CONTACT
  HUMAN
  AGENT
  SYSTEM
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  numberId       String
  number         WhatsAppNumber     @relation(fields: [numberId], references: [id], onDelete: Cascade)
  status         ConversationStatus @default(OPEN)
  aiPaused       Boolean            @default(false)
  needsHuman     Boolean            @default(false)
  assignedUserId String?
  assignedUser   User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime           @default(now())
  lastInboundAt  DateTime?
  createdAt      DateTime           @default(now())
  messages       Message[]

  @@unique([numberId, contactId])
  @@index([tenantId, lastMessageAt])
}

model Message {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  sender         MessageSender
  type           String           @default("text")
  body           String?
  waMessageId    String?          @unique
  status         MessageStatus
  error          String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
